---
import { business } from '../data/site';
import BrandMark from './BrandMark.astro';
import GraffitiWord from './GraffitiWord.astro';

const footerNavigation = [
  { label: 'Studio', href: '#studio' },
  { label: 'Lavori', href: '#lavori' },
  { label: 'Artisti', href: '#artisti' },
  { label: 'Contatti', href: '#contatti' },
];
---

<footer class="footer" id="footer">
  <div class="footer__top container container--wide">
    <a class="footer__brand" href="#top" aria-label="EVHIL Tattoo Studio, torna all'inizio">
      <BrandMark />
    </a>

    <nav aria-label="Navigazione nel footer">
      <ul>
        {footerNavigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <address>
      <strong>{business.name}</strong>
      <span>{business.street}</span>
      <span>{business.locality}</span>
      <a href={business.phoneHref}>{business.phoneDisplay}</a>
    </address>

    <div class="footer__contact">
      <a href={business.whatsappUrl} target="_blank" rel="noreferrer">WhatsApp</a>
      <span aria-disabled="true">Instagram · da collegare</span>
    </div>
  </div>

  <div class="footer__identity" aria-hidden="true">
    <GraffitiWord text="EVHIL" />
    <span>TATTOO STUDIO</span>
  </div>

  <div class="footer__bottom container container--wide">
    <p>EVHIL Tattoo Studio · Venegono Inferiore (VA)</p>
    <p>Sito in sviluppo · contenuti reali in aggiornamento</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: clip;
    padding-top: var(--space-xl);
    color: var(--color-ink);
    background: var(--color-canvas-soft);
    border-top: var(--section-rule);
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(10rem, 0.8fr) repeat(3, minmax(10rem, 0.55fr));
    gap: var(--space-lg);
    align-items: start;
  }

  .footer__brand {
    display: inline-flex;
    width: fit-content;
  }

  .footer ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer li + li {
    margin-top: var(--space-xs);
  }

  .footer nav a,
  .footer__contact a,
  .footer__contact span {
    color: inherit;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .footer address,
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--color-ink-muted);
    font-size: 0.9rem;
    font-style: normal;
  }

  .footer address strong,
  .footer address a {
    color: var(--color-ink);
  }

  .footer__contact {
    gap: var(--space-xs);
  }

  .footer__contact span {
    color: var(--color-ink-muted);
  }

  .footer__identity {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: clamp(18rem, 36vw, 35rem);
    margin-top: var(--space-xl);
    overflow: hidden;
    border-top: var(--section-rule);
  }

  .footer__identity :global(.graffiti-word) {
    position: absolute;
    z-index: 1;
    top: 14%;
    left: 8%;
  }

  .footer__identity > span {
    display: block;
    margin-bottom: -0.11em;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(8rem, 23vw, 24rem);
    font-weight: 900;
    letter-spacing: -0.075em;
    line-height: 0.65;
    white-space: nowrap;
    -webkit-text-stroke: 1px rgb(244 242 237 / 22%);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    padding-block: var(--space-sm);
    border-top: var(--section-rule);
  }

  .footer__bottom p {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 63.99rem) {
    .footer__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-xl);
    }
  }

  @media (max-width: 47.99rem) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }

    .footer address,
    .footer__contact {
      grid-column: 1 / -1;
    }

    .footer__identity {
      min-height: 23rem;
    }

    .footer__identity :global(.graffiti-word) {
      top: 18%;
      left: -0.2rem;
    }

    .footer__identity > span {
      font-size: 34vw;
    }

    .footer__bottom {
      flex-direction: column;
      gap: var(--space-xs);
    }
  }
</style>
