---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'text' | 'editorial';
  external?: boolean;
  compact?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  href,
  label,
  variant = 'primary',
  external = false,
  compact = false,
  ariaLabel,
  class: className,
} = Astro.props;

const accessibleLabel = ariaLabel ?? (external ? `${label} (si apre in una nuova scheda)` : undefined);
---

<a
  class:list={['cta', `cta--${variant}`, { 'cta--compact': compact }, className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
  aria-label={accessibleLabel}
>
  <span class="cta__label">{label}</span>
  <span class="cta__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="24" height="24">
      <path d="M5 12h13M13 6l6 6-6 6" />
    </svg>
  </span>
</a>

<style>
  .cta {
    --cta-foreground: var(--color-canvas);
    --cta-background: var(--color-ink);
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: 3.25rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sharp);
    color: var(--cta-foreground);
    background: var(--cta-background);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.075em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color var(--motion-base) var(--ease-out-expo),
      background-color var(--motion-base) var(--ease-out-expo),
      border-color var(--motion-base) var(--ease-out-expo);
  }

  .cta--primary {
    min-width: min(100%, 13rem);
    padding: 0.95rem 1.1rem;
  }

  .cta--compact {
    min-width: 0;
    min-height: 2.85rem;
    padding: 0.8rem 0.75rem;
    gap: 0.4rem;
  }

  .cta--primary::before {
    position: absolute;
    inset: -1px auto -1px -1px;
    width: 0.28rem;
    background: var(--color-accent);
    content: '';
  }

  .cta__icon {
    flex: 0 0 auto;
    transition: transform var(--motion-base) var(--ease-out-expo);
  }

  .cta__icon svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-width: 1.8;
  }

  .cta--text {
    --cta-foreground: var(--color-ink);
    --cta-background: transparent;
    min-height: auto;
    padding: 0.35rem 0;
    border: 0;
    border-bottom: 1px solid currentColor;
  }

  .cta--editorial {
    --cta-foreground: var(--color-ink-bright);
    --cta-background: var(--color-accent);
    width: 100%;
    min-height: clamp(8rem, 18vw, 14rem);
    padding: var(--space-md) var(--space-lg);
    border-color: transparent;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 7.5vw, 7.5rem);
    font-weight: 900;
    letter-spacing: -0.035em;
  }

  .cta--editorial .cta__icon svg {
    width: clamp(2.5rem, 7vw, 6rem);
    height: clamp(2.5rem, 7vw, 6rem);
    stroke-width: 1.2;
  }

  @media (hover: hover) and (pointer: fine) {
    .cta:hover {
      --cta-foreground: var(--color-ink-bright);
      --cta-background: var(--color-surface-raised);
      border-color: var(--color-accent);
    }

    .cta:hover .cta__icon {
      transform: translateX(0.35rem);
    }

    .cta--text:hover {
      --cta-background: transparent;
      color: var(--color-accent-bright);
    }

    .cta--editorial:hover {
      --cta-background: var(--color-accent-bright);
      border-color: transparent;
    }
  }

  @media (max-width: 47.99rem) {
    .cta--compact .cta__icon {
      display: none;
    }
  }
</style>
