---
import heroImage from '../../references/photography/01-tattoo-detail-finished.jpg';
import { business } from '../data/site';
import CTA from './CTA.astro';
import GraffitiWord from './GraffitiWord.astro';
---

<section class="home-hero" id="top" aria-labelledby="home-hero-title">
  <div class="home-hero__media" data-parallax-frame>
    <img
      src={heroImage.src}
      width={heroImage.width}
      height={heroImage.height}
      alt="Immagine temporanea di riferimento: dettaglio ravvicinato di un tatuaggio"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      data-parallax
    />
    <div class="home-hero__shade"></div>
  </div>

  <div class="home-hero__content">
    <p class="home-hero__location" data-reveal>Venegono Inferiore · Varese</p>
    <h1 id="home-hero-title">
      <GraffitiWord text="EVHIL" />
      <span class="home-hero__structural" data-reveal>Tattoo<br />Studio</span>
    </h1>

    <div class="home-hero__lower" data-reveal>
      <p>
        Tattoo su misura, pensati intorno alla persona e al corpo.
        Identità street, cura professionale, lavoro costruito insieme.
      </p>
      <div class="home-hero__actions">
        <CTA
          href={business.whatsappUrl}
          label="Richiedi un preventivo"
          ariaLabel="Richiedi un preventivo su WhatsApp"
          external
        />
        <CTA href="#lavori" label="Guarda i lavori" variant="text" />
      </div>
    </div>
  </div>

  <p class="home-hero__reference">Reference visiva temporanea · non è lavoro EVHIL</p>
  <span class="home-hero__ink" aria-hidden="true">INK</span>
</section>

<style>
  .home-hero {
    position: relative;
    display: grid;
    min-height: max(46rem, 100svh);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-canvas);
  }

  .home-hero__media {
    position: absolute;
    z-index: -2;
    inset: 0 0 0 38%;
    overflow: hidden;
  }

  .home-hero__media img {
    position: absolute;
    inset: -5% 0;
    width: 100%;
    height: 110%;
    object-fit: cover;
    object-position: 54% center;
    filter: saturate(0.82) contrast(1.08);
  }

  .home-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--color-canvas) 0%, rgb(5 5 5 / 88%) 22%, transparent 65%),
      linear-gradient(to top, rgb(5 5 5 / 74%), transparent 42%);
  }

  .home-hero__content {
    z-index: 1;
    align-self: end;
    width: min(100%, var(--content-wide));
    padding: clamp(8rem, 15vh, 11rem) var(--gutter) var(--space-lg);
    margin-inline: auto;
  }

  .home-hero__location {
    width: fit-content;
    padding-bottom: var(--space-2xs);
    margin: 0 0 var(--space-md) auto;
    border-bottom: var(--section-rule);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    width: min-content;
    margin: 0;
    line-height: 0.7;
  }

  .home-hero__structural {
    display: block;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(5.4rem, min(12.5vw, 19vh), 12.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.69;
    text-transform: uppercase;
  }

  .home-hero__lower {
    display: grid;
    grid-template-columns: minmax(16rem, 34rem) auto;
    gap: var(--space-lg);
    align-items: end;
    width: min(100%, 65rem);
    margin-top: var(--space-lg);
    margin-left: clamp(0rem, 8vw, 8rem);
  }

  .home-hero__lower > p {
    max-width: 44ch;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: clamp(0.95rem, 1.2vw, 1.125rem);
  }

  .home-hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .home-hero__reference {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-md);
    max-width: 15rem;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-align: right;
    text-transform: uppercase;
  }

  .home-hero__ink {
    position: absolute;
    z-index: -1;
    top: 2%;
    left: -0.12em;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(13rem, 34vw, 34rem);
    font-weight: 900;
    letter-spacing: -0.08em;
    line-height: 1;
    -webkit-text-stroke: 1px rgb(244 242 237 / 9%);
  }

  @media (max-width: 79.99rem) {
    .home-hero__reference {
      top: 6.25rem;
      bottom: auto;
      max-width: 12rem;
      padding: 0.45rem 0.55rem;
      background: rgb(5 5 5 / 78%);
    }

    .home-hero__lower {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      width: min(100%, 48rem);
      margin-left: clamp(0rem, 5vw, 5rem);
    }

    .home-hero__actions {
      flex-flow: row wrap;
      align-items: center;
    }
  }

  @media (max-width: 63.99rem) {
    .home-hero__media {
      left: 31%;
    }

    .home-hero__location {
      margin-left: 0;
    }

    .home-hero__lower {
      margin-left: 0;
    }
  }

  @media (max-width: 47.99rem) {
    .home-hero {
      min-height: 100svh;
    }

    .home-hero__media {
      inset: 0;
    }

    .home-hero__media img {
      object-position: 59% center;
    }

    .home-hero__shade {
      background:
        linear-gradient(to top, var(--color-canvas) 3%, rgb(5 5 5 / 82%) 43%, transparent 78%),
        linear-gradient(to right, rgb(5 5 5 / 56%), transparent 70%);
    }

    .home-hero__content {
      padding-top: 8rem;
      padding-bottom: var(--space-md);
    }

    .home-hero__location {
      margin-bottom: auto;
      font-size: 0.64rem;
    }

    .home-hero__reference {
      top: 5.5rem;
      max-width: 10.5rem;
      font-size: 0.54rem;
    }

    h1 {
      width: 100%;
      margin-top: clamp(13rem, 31vh, 17rem);
    }

    .home-hero__structural {
      font-size: clamp(3.8rem, 20vw, 6rem);
    }

    .home-hero__lower {
      display: block;
      margin-top: var(--space-md);
    }

    .home-hero__lower > p {
      max-width: 31ch;
      font-size: 0.9rem;
    }

    .home-hero__actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-sm);
      margin-top: var(--space-md);
    }

    .home-hero__actions :global(.cta--primary) {
      width: 100%;
    }

    .home-hero__ink {
      top: 13%;
      left: -0.2em;
      font-size: 15rem;
    }
  }
</style>
