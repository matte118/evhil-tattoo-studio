---
import locationImage from '../../references/photography/03-studio-graffiti-environment.jpg';
import { business } from '../data/site';
import CTA from './CTA.astro';
import Section from './Section.astro';
---

<Section id="contatti" width="wide" surface="surface" class="contact">
  <div class="contact__layout">
    <div class="contact__media" data-reveal>
      <img
        src={locationImage.src}
        width={locationImage.width}
        height={locationImage.height}
        alt="Immagine temporanea di riferimento per lo spazio studio"
        loading="lazy"
        decoding="async"
      />
      <span>Spazio reale da fotografare · reference non EVHIL</span>
    </div>

    <div class="contact__copy" data-reveal>
      <p class="contact__label">Dove trovarci</p>
      <h2>VENEGONO<br />INFERIORE</h2>
      <address>
        <strong>{business.name}</strong>
        <span>{business.street}</span>
        <span>{business.locality}</span>
        <a href={business.phoneHref}>{business.phoneDisplay}</a>
      </address>

      <div class="contact__actions">
        <CTA
          href={business.whatsappUrl}
          label="WhatsApp"
          ariaLabel="Contatta EVHIL Tattoo Studio su WhatsApp (si apre in una nuova scheda)"
          external
        />
        <span class="contact__social" aria-disabled="true">Instagram · profilo da collegare</span>
      </div>
    </div>
  </div>
</Section>

<style>
  :global(.contact) {
    overflow: clip;
  }

  .contact__layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(24rem, 1.2fr);
    min-height: clamp(36rem, 58vw, 52rem);
    border: var(--section-rule);
  }

  .contact__media {
    position: relative;
    overflow: hidden;
  }

  .contact__media::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(5 5 5 / 80%), transparent 62%);
    content: '';
  }

  .contact__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
  }

  .contact__media span {
    position: absolute;
    z-index: 1;
    right: var(--space-sm);
    bottom: var(--space-sm);
    left: var(--space-sm);
    color: var(--color-ink-muted);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .contact__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 6vw, 6rem);
  }

  .contact__label {
    margin: 0 0 var(--space-md);
    color: var(--color-accent-bright);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact__copy h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.4rem, 9vw, 9rem);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 0.7;
  }

  address {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-xl);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    font-style: normal;
    line-height: 1.5;
  }

  address strong {
    margin-bottom: var(--space-xs);
  }

  address a {
    width: fit-content;
    margin-top: var(--space-sm);
    color: var(--color-ink);
  }

  .contact__actions {
    display: flex;
    gap: var(--space-lg);
    align-items: center;
    margin-top: var(--space-xl);
  }

  .contact__social {
    color: var(--color-ink-muted);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  @media (max-width: 47.99rem) {
    .contact__layout {
      grid-template-columns: 1fr;
    }

    .contact__media {
      min-height: 23rem;
    }

    .contact__copy {
      padding: var(--space-xl) var(--space-md);
    }

    .contact__copy h2 {
      font-size: clamp(4rem, 19vw, 6rem);
    }

    .contact__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
