---
import eventImage from '../../references/photography/04-sketch-creative-process.jpg';
import { homepageEvent } from '../data/site';
import GraffitiLabel from './GraffitiLabel.astro';
import GraffitiWord from './GraffitiWord.astro';
import Section from './Section.astro';
---

<Section id="eventi" width="wide" surface="canvas" class="events">
  <article class="event" data-event-placeholder data-reveal>
    <div class="event__poster">
      <img
        src={eventImage.src}
        width={eventImage.width}
        height={eventImage.height}
        alt="Immagine temporanea di riferimento: disegno e processo creativo"
        loading="lazy"
        decoding="async"
      />
      <span>Reference non EVHIL</span>
    </div>

    <div class="event__copy">
      <GraffitiLabel text="spazio vivo" tone="violet" />
      <p class="event__status">{homepageEvent.status}</p>
      <h2>
        <span class="event__title-long">{homepageEvent.title}</span>
        <span class="event__title-short">{homepageEvent.mobileTitle}</span>
      </h2>
      <p>{homepageEvent.description}</p>
      <span class="event__link" aria-disabled="true">Aggiornamenti in arrivo</span>
    </div>

    <div class="event__mark" aria-hidden="true">
      <GraffitiWord text="FLASH" size="section" />
    </div>
  </article>
</Section>

<style>
  :global(.events) {
    overflow: clip;
    padding-block: var(--space-xl);
  }

  .event {
    position: relative;
    display: grid;
    grid-template-columns: minmax(15rem, 0.65fr) minmax(20rem, 1fr);
    min-height: clamp(28rem, 39vw, 34rem);
    border: var(--section-rule);
    isolation: isolate;
  }

  .event__poster {
    position: relative;
    min-height: 100%;
    overflow: hidden;
  }

  .event__poster::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(5 5 5 / 74%), transparent 60%);
    content: '';
  }

  .event__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
  }

  .event__poster > span {
    position: absolute;
    z-index: 1;
    bottom: var(--space-sm);
    left: var(--space-sm);
    color: var(--color-ink-muted);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .event__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 6vw, 6rem);
    background: var(--color-surface);
  }

  .event__status {
    margin: var(--space-lg) 0 var(--space-xs);
    color: var(--color-accent-bright);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .event__copy h2 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 5vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 0.76;
    text-transform: uppercase;
  }

  .event__title-short {
    display: none;
  }

  .event__copy > p:not(.event__status) {
    max-width: 42ch;
    margin: var(--space-lg) 0;
    color: var(--color-ink-muted);
    font-size: var(--text-lead);
  }

  .event__link {
    width: fit-content;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--color-border-strong);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event__mark {
    position: absolute;
    z-index: 2;
    right: -1rem;
    bottom: -2rem;
  }

  @media (max-width: 47.99rem) {
    .event {
      width: 100%;
      min-width: 0;
      grid-template-columns: minmax(0, 1fr);
    }

    .event__poster {
      min-height: 19rem;
      clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%);
    }

    .event__copy {
      min-width: 0;
      padding: var(--space-lg) var(--space-md) calc(var(--space-xl) + 2rem);
    }

    .event__copy h2 {
      font-size: clamp(3.2rem, 14vw, 4.7rem);
    }

    .event__title-long {
      display: none;
    }

    .event__title-short {
      display: block;
    }

    .event__mark {
      right: -0.7rem;
      bottom: -0.5rem;
    }
  }
</style>
