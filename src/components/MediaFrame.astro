---
interface Props {
  src: string;
  alt: string;
  caption: string;
  meta?: string;
  ratio?: string;
  treatment?: 'natural' | 'mono';
  parallax?: boolean;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  src,
  alt,
  caption,
  meta,
  ratio = '4 / 5',
  treatment = 'natural',
  parallax = false,
  loading = 'lazy',
  class: className,
} = Astro.props;
---

<figure
  class:list={['media-frame', `media-frame--${treatment}`, className]}
  style={`--media-ratio: ${ratio}`}
  data-parallax-frame={parallax ? '' : undefined}
>
  <div class="media-frame__visual">
    <img
      src={src}
      alt={alt}
      loading={loading}
      decoding="async"
      data-parallax={parallax ? '' : undefined}
    />
    <span class="media-frame__status">Reference · non EVHIL</span>
  </div>
  <figcaption>
    <span>{caption}</span>
    {meta && <small>{meta}</small>}
  </figcaption>
</figure>

<style>
  .media-frame {
    margin: 0;
  }

  .media-frame__visual {
    position: relative;
    aspect-ratio: var(--media-ratio);
    overflow: hidden;
    background: var(--color-surface);
  }

  .media-frame img {
    position: absolute;
    inset: -5% 0;
    width: 100%;
    height: 110%;
    object-fit: cover;
    transition:
      filter var(--motion-slow) var(--ease-out-expo),
      scale var(--motion-slow) var(--ease-out-expo);
  }

  .media-frame--mono img {
    filter: grayscale(1) contrast(1.12);
  }

  .media-frame__visual::after {
    position: absolute;
    inset: 0;
    border: 1px solid rgb(244 242 237 / 12%);
    box-shadow: inset 0 -5rem 5rem -5rem rgb(0 0 0 / 85%);
    content: '';
    pointer-events: none;
  }

  .media-frame__status {
    position: absolute;
    z-index: 1;
    top: var(--space-sm);
    left: var(--space-sm);
    padding: 0.45rem 0.55rem;
    color: var(--color-ink-bright);
    background: rgb(5 5 5 / 86%);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1;
    text-transform: uppercase;
  }

  figcaption {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: baseline;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-label);
    font-weight: 650;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  figcaption:has(small) {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  figcaption small {
    color: var(--color-ink-muted);
    font-size: 0.68rem;
    font-weight: 500;
    text-align: right;
  }

  @media (hover: hover) and (pointer: fine) {
    .media-frame:hover img {
      filter: grayscale(0) contrast(1.05);
      scale: 1.018;
    }
  }

  @media (max-width: 40rem) {
    figcaption {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    figcaption small {
      text-align: left;
    }
  }
</style>
