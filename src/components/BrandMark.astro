---
import logo from '../../references/brand/logo-transparent-bg.png';

interface Props {
  compact?: boolean;
  class?: string;
}

const { compact = false, class: className } = Astro.props;
---

<span class:list={['brand-mark', { 'brand-mark--compact': compact }, className]}>
  <img
    src={logo.src}
    width={logo.width}
    height={logo.height}
    alt="EVHIL Tattoo Studio"
    loading="eager"
    decoding="async"
  />
</span>

<style>
  .brand-mark {
    display: inline-grid;
    width: clamp(7.5rem, 10vw, 10.5rem);
    aspect-ratio: 3 / 1.35;
    overflow: hidden;
  }

  .brand-mark img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    filter: invert(1) contrast(1.4);
  }

  .brand-mark--compact {
    width: clamp(6.2rem, 22vw, 8.25rem);
  }
</style>

