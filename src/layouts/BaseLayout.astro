---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, structuredData } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <title>{title}</title>
  </head>
  <body>
    <!--
      THESIS: EVHIL reads as tattoo culture through dominant photography, structural type and a physical graffiti layer.
      OWN-WORLD: Near-black fields, off-white ink, restrained violet, sharp rules, mixed-scale photography and controlled street marks.
      STORY: Identity first; studio approach; work; people; activity; trust; direct contact; place.
      FIRST VIEWPORT: Editorial header, tattoo crop, EVHIL handstyle, condensed title and visible WhatsApp action.
      FORM: Dark Graffiti Editorial homepage; production structure with clearly marked temporary media and content.
      FINISH: Browser review, responsive QA and design critique are required before completion.
    -->
    <slot />

    <script>
      import { initFoundationMotion } from '../scripts/foundation-motion';

      initFoundationMotion();
    </script>
  </body>
</html>
